# --- Supabase (database + auth; stays after the Cloudflare migration) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Legacy Cloudinary (kept only until the Cloudinary -> R2 cutover) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Cloudflare account (vars; also set in wrangler.jsonc) ---
# Account ID shown on the Cloudflare dashboard homepage.
CF_ACCOUNT_ID=your-account-id
# Key prefix segment: "production" or "development" (never mix with live keys).
R2_ENV=development
# Public delivery domain for the hb-media bucket (custom domain, not the S3 endpoint).
NEXT_PUBLIC_MEDIA_DOMAIN=media.honeysbees.com

# --- R2 S3-compatible API tokens (secrets; `wrangler secret put` in production) ---
# Create per-bucket scoped tokens in R2 -> Manage API Keys.
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key

# --- Cloudflare Stream (video) ---
# Defaults to CF_ACCOUNT_ID when omitted.
CLOUDFLARE_STREAM_ACCOUNT_ID=your-stream-account-id
# API token with Stream:Edit permission.
CLOUDFLARE_STREAM_API_TOKEN=your-stream-api-token
# Webhook signing secret from Stream -> Settings -> Webhooks (Hex key).
CLOUDFLARE_STREAM_WEBHOOK_SECRET=your-stream-webhook-secret

# --- Cloudflare Turnstile (login / register / provider onboarding) ---
# Sitekey is public; the secret is a server-only `wrangler secret put`.
NEXT_PUBLIC_TURNSTILE_SITEKEY=your-turnstile-sitekey
TURNSTILE_SECRET=your-turnstile-secret
