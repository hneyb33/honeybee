APP_NAME=HoneyBee
APP_ENV=production
APP_KEY=base64:Mt/sxHHWodSiLxVanoNS2FkQ7Uvu8QVIQ37pPncynPo=
APP_DEBUG=false
APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=database
APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_URL=${{Postgres.DATABASE_URL}}
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=database
FILESYSTEM_DISK=database

# Profile photos. Leave MEDIA_DISK=public only for a single long-lived server.
# Production should use Cloudflare R2 (S3-compatible, cached at the edge):
# MEDIA_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=
# AWS_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# AWS_URL=https://media.example.com
# AWS_USE_PATH_STYLE_ENDPOINT=true
MEDIA_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


VITE_APP_NAME="${APP_NAME}"

# Leave blank to skip payment and activate plans immediately.
# Set one or both on Railway to turn on merchant-code payments.
MTN_MOMO_MERCHANT_CODE=
AIRTEL_MONEY_MERCHANT_CODE=


